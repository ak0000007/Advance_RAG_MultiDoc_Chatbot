# API Keys (Do not share these!)
GOOGLE_API_KEY="your_google_api_key_here"
DEEPSEEK_API_KEY="your_deepseek_api_key_here"
OPENAI_API_KEY="your_openai_api_key_here"

# Tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY="your_langsmith_api_key_here"

# Qdrant Vector Database
QDRANT_API_KEY=""
QDRANT_URL="http://localhost:6333"

# PostgreSQL Memory Database
POSTGRES_USER="admin"
POSTGRES_PASSWORD="your_secure_password_here"
POSTGRES_DB="rag_db"
POSTGRES_URL="postgresql://admin:your_secure_password_here@localhost:5432/rag_db"

# Salesforce Integration (JWT Bearer Flow)
# Place your server.key file in a secure location outside version control (e.g., ./secrets/server.key)
SF_CLIENT_ID="your_connected_app_client_id"
SF_LOGIN_URL="https://login.salesforce.com"
SF_PRIVATE_KEY_PATH="./secrets/server.key"
SF_DOMAIN="https://your-domain.my.salesforce.com"

# Salesforce Record-Level Access Control & Short-Lived User JWT Auth
SF_AUTH_ENABLED=false
SF_JWT_PUBLIC_KEY=""
SF_JWT_PUBLIC_KEY_PATH=""
SF_JWT_AUDIENCE="advance-rag-travel-copilot"
SF_JWT_ISSUER="https://login.salesforce.com"
SF_JWT_MAX_LIFETIME_SECONDS=120
SF_ACCESS_CACHE_TTL_SECONDS=60
SF_ACCESS_OVERFETCH_FACTOR=4
