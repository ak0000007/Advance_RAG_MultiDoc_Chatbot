# API Keys (Do not share these!)
GOOGLE_API_KEY="your_google_api_key_here"
DEEPSEEK_API_KEY="your_deepseek_api_key_here"
OPENAI_API_KEY="your_openai_api_key_here"

# Tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY="your_langsmith_api_key_here"

# Qdrant Vector Database
QDRANT_API_KEY=""
QDRANT_URL="http://localhost:6333"

# PostgreSQL Memory Database
POSTGRES_USER="admin"
POSTGRES_PASSWORD="your_secure_password_here"
POSTGRES_DB="rag_db"
POSTGRES_URL="postgresql://admin:your_secure_password_here@localhost:5432/rag_db"

# Environment & Security Configuration
ENVIRONMENT="development"
DEV_MODE=true

# LLM Provider & Model Selection
LLM_PROVIDER="google"
# LLM_MODEL=""

# Deployment Topology & Credential Isolation (BYOK)
# solo (default): you are the sole operator/tenant. Put your key above. Fallback to OPENAI_API_KEY allowed.
DEPLOYMENT_MODE="solo"
ALLOW_OPERATOR_FALLBACK=true

# hosted_byok: every tenant brings their own key in API_KEY_MAPPING — zero operator credit leakage
# DEPLOYMENT_MODE="hosted_byok"
# API_KEY_MAPPING='{"key_acme":{"username":"a@acme.com","tenant_id":"acme","llm_provider":"google","llm_api_key":"AIza...","llm_fallback_provider":"openai","llm_fallback_api_key":"sk-..."}}'

# hosted_shared: operator hosts with shared key, enforcing tenant token quotas
# DEPLOYMENT_MODE="hosted_shared"
# TENANT_QUOTA_DAILY_TOKENS=100000

# Thread Ownership & Access Control (P0-1)
ALLOW_UNOWNED_THREADS=false
APPROVER_ROLES=""

# CRM Module Toggle (defaults to true if SF credentials/mock present, set false for docs-only)
CRM_ENABLED=true

# Conversation Memory Management (bounded working context window; 0 = unlimited)
MAX_MESSAGES=50

# Salesforce Integration (JWT Bearer Flow)
# Place your server.key file in a secure location outside version control (e.g., ./secrets/server.key)
SF_CLIENT_ID="your_connected_app_client_id"
SF_LOGIN_URL="https://login.salesforce.com"
SF_PRIVATE_KEY_PATH="./secrets/server.key"
SF_DOMAIN="https://your-domain.my.salesforce.com"

# Salesforce Record-Level Access Control & Short-Lived User JWT Auth
SF_AUTH_ENABLED=false
SF_JWT_PUBLIC_KEY=""
SF_JWT_PUBLIC_KEY_PATH=""
SF_JWT_AUDIENCE="advance-rag-travel-copilot"
SF_JWT_ISSUER="https://login.salesforce.com"
SF_JWT_MAX_LIFETIME_SECONDS=120
SF_ACCESS_CACHE_TTL_SECONDS=60
SF_ACCESS_OVERFETCH_FACTOR=4

# Rate Limiting & Cost Governance
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS_PER_MINUTE=60
MAX_STREAMING_TOKENS=4096

